/ {
    behaviors {

        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_A_AE";             // tap → A (GUI when held) | double-tap → Ä (A-umlaut)
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hml LGUI A>, <&kp RA(Q)>;  // RA(Q) = AltGr+Q = Ä  (adjust if your layout differs)
        };

        td_p: tap_dance_p {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_P_ARING";          // tap → P | double-tap → Å (A-ring)
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp P>, <&kp RA(A)>;        // RA(A) = AltGr+A = Å
        };

        td_semi_aa: tap_dance_semi_aring {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SEMI_ARING";       // tap → ; | double-tap → Å  (Colemak top-right)
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&kp RA(A)>;     // RA(A) = AltGr+A = Å
        };

        td_o_colemak: tap_dance_o_colemak {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_O_OE";             // tap → O (RCTRL when held) | double-tap → Ö  (Colemak home-right)
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hmr RCTRL O>, <&kp RA(O)>;  // RA(O) = AltGr+O = Ö
        };

        td_nav_num: tap_dance_nav_num {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NAV_NUM";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            // Single tap toggles NAV (tap again to exit).
            // Double tap toggles NUM (double-tap again to exit).
            // Reworked on 2026-05-22 from <&mo NAV>, <&num_word NUM>:
            // num_word came from urob/zmk-auto-layer which has no ZMK-main
            // compatible release. &tog gives a self-exiting key, which the
            // momentary form lacked anyway.
            bindings = <&tog NAV>, <&tog NUM>;
        };

        td_colemak: tap_dance_colemak {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COLEMAK";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&trans>, <&tog COLEMAK>;  // single-tap = pass-through; double-tap = toggle Colemak DH
        };

        // Replaces the old `&mo_tog SYSTEM SYSTEM` on the left SYS thumb.
        // Single-tap → momentary SYSTEM (media, BT controls, etc.)
        // Double-tap → toggle GAMING layer on/off
        //
        // Why a tap-dance and not `&mo_tog`: `mo_tog` couples the hold target
        // and the double-tap target. We need momentary SYSTEM on tap-hold and
        // a DIFFERENT layer (GAMING) on double-tap.
        td_sys_gaming: tap_dance_sys_gaming {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SYS_GAMING";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&mo SYSTEM>, <&tog GAMING>;
        };

    };
};
