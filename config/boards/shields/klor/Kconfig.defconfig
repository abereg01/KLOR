if SHIELD_KLOR_LEFT

    # Note: ZMK_KEYBOARD_NAME is intentionally NOT set here.
    # Both halves are now peripherals to the Prospector dongle (xiao_ble +
    # klor_dongle + prospector_adapter shield in the prospector repo), which
    # is the device that advertises as HID and owns the visible name.
    # Peripherals don't expose themselves to the host; they only advertise
    # to the central over the ZMK split protocol.

    # ZMK_SPLIT_BLE_ROLE_CENTRAL is intentionally NOT set here.
    # When ZMK_SPLIT=y is enabled without the central role flag, the device
    # defaults to peripheral. The Prospector dongle is the sole central.

endif # LEFT



if SHIELD_KLOR_LEFT || SHIELD_KLOR_RIGHT

    config ZMK_SPLIT
        default y


if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY



if LVGL

    config LV_Z_VDB_SIZE
        default 64

    config LV_DPI_DEF
        default 148

    config LV_Z_BITS_PER_PIXEL
        default 1

    choice LV_COLOR_DEPTH
        default LV_COLOR_DEPTH_1
    endchoice

endif # LVGL


endif # LEFT RIGHT
